logging {
  level  = "info"
  format = "logfmt"
}

local.file_match "sam_logs" {
  path_targets = [{"__path__" = "/var/log/social-media/*.jsonl"}]
}

loki.source.file "sam_logs" {
  targets    = local.file_match.sam_logs.targets
  forward_to = [loki.process.sam_logs.receiver]
}

loki.process "sam_logs" {
  stage.json {
    expressions = {
      service_name = "service_name",
    }
  }

  stage.labels {
    values = {
      service_name = "",
    }
  }

  stage.static_labels {
    values = {source = "sam-lambda"}
  }
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
