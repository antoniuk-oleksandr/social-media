FROM golang:1.27.3-bookworm AS go-tools

RUN go install golang.org/x/tools/gopls@v0.23.0

FROM nousresearch/hermes-agent:latest

COPY --from=go-tools /usr/local/go /usr/local/go
COPY --from=go-tools /go/bin/gopls /usr/local/bin/gopls

ENV PATH="/usr/local/go/bin:/usr/local/bin:/opt/hermes/bin:/opt/hermes/.venv/bin:/opt/data/.local/bin:${PATH}"
ENV HERMES_WRITE_SAFE_ROOT=/workspace
